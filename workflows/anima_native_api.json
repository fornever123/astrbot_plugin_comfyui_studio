{
  "anima_model": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "anima-base-v1.0.safetensors",
      "weight_dtype": "default"
    }
  },
  "anima_clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_3_06b_base.safetensors",
      "type": "qwen_image",
      "device": "cpu"
    }
  },
  "anima_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_image_vae.safetensors"
    }
  },
  "positive": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "anima_clip",
        0
      ],
      "text": ""
    }
  },
  "negative": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "anima_clip",
        0
      ],
      "text": ""
    }
  },
  "anima_sampling": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": {
      "model": [
        "anima_model",
        0
      ],
      "shift": 3.0
    }
  },
  "anima_latent": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "anima_sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "anima_sampling",
        0
      ],
      "positive": [
        "positive",
        0
      ],
      "negative": [
        "negative",
        0
      ],
      "latent_image": [
        "anima_latent",
        0
      ],
      "seed": 0,
      "steps": 30,
      "cfg": 5.0,
      "sampler_name": "er_sde",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "anima_decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "anima_sampler",
        0
      ],
      "vae": [
        "anima_vae",
        0
      ]
    }
  },
  "anima_save": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "anima_decode",
        0
      ],
      "filename_prefix": "astrbot/anima"
    }
  }
}
